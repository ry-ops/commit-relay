  "achievements": {
    "pair_extraordinaire": {
      "id": "pair_extraordinaire",
      "name": "Pair Extraordinaire",
      "description": "Co-author commits in merged pull requests",
      "icon": "👥",
      "category": "collaboration",
      "earnable": true,
      "automation_priority": "high",
      "tiers": [
        {
          "name": "default",
          "requirement": 1,
          "description": "1 coauthored PR merged"
        },
        {
          "name": "bronze",
          "multiplier": "x2",
          "requirement": 10,
          "description": "10 coauthored PRs merged"
        },
        {
          "name": "silver",
          "multiplier": "x3",
          "requirement": 24,
          "description": "24 coauthored PRs merged"
        },
        {
          "name": "gold",
          "multiplier": "x4",
          "requirement": 48,
          "description": "48 coauthored PRs merged"
        }
      ],
      "github_api": {
        "endpoint": "/search/commits",
        "query_param": "author:USERNAME+co-author:*"
      },
      "automation": {
        "enabled": true,
        "strategy": "coauthor_commits",
        "notes": "commit-relay already does this via Co-Authored-By: Claude"
      }
    },
    "pull_shark": {
      "id": "pull_shark",
      "name": "Pull Shark",
      "description": "Open PRs that get merged",
      "icon": "🦈",
      "category": "contribution",
      "earnable": true,
      "automation_priority": "high",
      "tiers": [
        {
          "name": "bronze",
          "requirement": 2,
          "description": "2 merged PRs"
        },
        {
          "name": "silver",
          "multiplier": "x2",
          "requirement": 16,
          "description": "16 merged PRs"
        },
        {
          "name": "gold",
          "multiplier": "x3",
          "requirement": 128,
          "description": "128 merged PRs"
        },
        {
          "name": "platinum",
          "multiplier": "x4",
          "requirement": 1024,
          "description": "1,024 merged PRs"
        }
      ],
      "github_api": {
        "endpoint": "/search/issues",
        "query_param": "type:pr+author:USERNAME+is:merged"
      },
      "automation": {
        "enabled": true,
        "strategy": "feature_branch_workflow",
        "workflow": "Create feature branch → Implement → PR → Auto-merge",
        "master": "development-master"
      }
    },
