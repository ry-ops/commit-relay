  "coordination_protocols": {
    "parallel_batch": {
      "description": "Spawn multiple workers in parallel for independent tasks",
      "use_case": "Multi-repo scans, parallel implementation of components",
      "max_workers": 8,
      "wait_strategy": "wait_all",
      "failure_handling": "continue_partial",
      "example": "Scan 6 repositories in parallel for CVE-2024-1234"
    },
    "sequential_pipeline": {
      "description": "Chain workers where output of one feeds into next",
      "use_case": "Research → Design → Implementation → Test → Review → PR",
      "max_workers": 6,
      "wait_strategy": "wait_each",
      "failure_handling": "abort_pipeline",
      "example": "Feature development workflow"
    },
    "parallel_components": {
      "description": "Implement different components in parallel",
      "use_case": "Frontend + Backend + API + Tests developed concurrently",
      "max_workers": 5,
      "wait_strategy": "wait_all",
      "failure_handling": "continue_partial",
      "example": "User dashboard with real-time updates"
    },
    "sequential_with_verification": {
      "description": "Apply changes sequentially with verification between steps",
      "use_case": "Security patches with verification scans",
      "max_workers": 4,
      "wait_strategy": "wait_each_with_validation",
      "failure_handling": "abort_on_verification_failure",
      "example": "Apply CVE fixes and verify no regressions"
    },
    "dag_based": {
      "description": "Complex dependency graph with mixed parallel and sequential phases",
      "use_case": "Large refactoring, multi-phase implementations",
      "max_workers": 10,
      "wait_strategy": "dag_topological_sort",
      "failure_handling": "replan_on_failure",
      "example": "Migrate authentication system across 5 services"
    }
  },
