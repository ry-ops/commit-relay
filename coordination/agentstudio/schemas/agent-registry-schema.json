{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Registry Schema",
  "description": "Schema for agent registration and catalog in Agentstudio",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "agent_id",
    "agent_type",
    "agent_class",
    "name",
    "version",
    "status",
    "capabilities",
    "registered_at"
  ],
  "properties": {
    "agent_id": {
      "type": "string",
      "description": "Unique identifier for the agent instance",
      "pattern": "^[a-z]+-[a-z]+-[a-f0-9]{8}$",
      "examples": ["coordinator-master-abc12345", "dev-worker-def67890"]
    },
    "agent_type": {
      "type": "string",
      "description": "Type of agent in the system",
      "enum": [
        "master",
        "worker",
        "learning",
        "daemon",
        "utility"
      ]
    },
    "agent_class": {
      "type": "string",
      "description": "Specific class/role of the agent",
      "enum": [
        "coordinator-master",
        "development-master",
        "security-master",
        "inventory-master",
        "cicd-master",
        "dashboard-agent",
        "commit-relay",
        "analysis-worker",
        "implementation-worker",
        "scan-worker",
        "test-worker",
        "critic",
        "learner",
        "problem-generator",
        "heartbeat-monitor",
        "anomaly-detector",
        "metrics-aggregator",
        "event-streamer",
        "zombie-cleanup",
        "worker-restart",
        "auto-fix",
        "failure-pattern-detector"
      ]
    },
    "name": {
      "type": "string",
      "description": "Human-readable name for the agent",
      "minLength": 1,
      "maxLength": 100,
      "examples": ["Coordinator Master", "Security Scanner Worker"]
    },
    "description": {
      "type": "string",
      "description": "Detailed description of agent's purpose",
      "maxLength": 500
    },
    "version": {
      "type": "string",
      "description": "Semantic version of the agent",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "examples": ["1.0.0", "2.1.3"]
    },
    "status": {
      "type": "string",
      "description": "Current operational status",
      "enum": [
        "active",
        "idle",
        "busy",
        "starting",
        "stopping",
        "error",
        "retired"
      ]
    },
    "capabilities": {
      "type": "array",
      "description": "List of capabilities the agent provides",
      "items": {
        "type": "object",
        "required": ["capability_id", "name", "category"],
        "properties": {
          "capability_id": {
            "type": "string",
            "description": "Unique identifier for the capability",
            "examples": ["task_routing", "vulnerability_scanning", "code_analysis"]
          },
          "name": {
            "type": "string",
            "description": "Human-readable capability name"
          },
          "category": {
            "type": "string",
            "description": "Category of capability",
            "enum": [
              "orchestration",
              "development",
              "security",
              "testing",
              "monitoring",
              "learning",
              "maintenance",
              "documentation",
              "deployment"
            ]
          },
          "parameters": {
            "type": "object",
            "description": "Configuration parameters for the capability",
            "additionalProperties": true
          },
          "prerequisites": {
            "type": "array",
            "description": "Required capabilities or conditions",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "configuration": {
      "type": "object",
      "description": "Agent configuration settings",
      "properties": {
        "max_concurrent_tasks": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 300
        },
        "retry_attempts": {
          "type": "integer",
          "minimum": 0,
          "default": 3
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"],
          "default": "medium"
        },
        "auto_restart": {
          "type": "boolean",
          "default": true
        },
        "resource_limits": {
          "type": "object",
          "properties": {
            "max_memory_mb": {
              "type": "integer",
              "minimum": 128
            },
            "max_cpu_percent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "max_token_budget": {
              "type": "integer",
              "minimum": 1000
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "performance": {
      "type": "object",
      "description": "Performance metrics and statistics",
      "properties": {
        "tasks_completed": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "tasks_failed": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "success_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "average_execution_time_ms": {
          "type": "number",
          "minimum": 0
        },
        "total_tokens_used": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "uptime_seconds": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "last_task_timestamp": {
          "type": "integer",
          "description": "Unix timestamp (ms) of last task execution"
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata about the agent",
      "properties": {
        "owner": {
          "type": "string",
          "description": "Owner or creator of the agent"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "documentation_url": {
          "type": "string",
          "format": "uri"
        },
        "source_location": {
          "type": "string",
          "description": "File path or repository location"
        },
        "dependencies": {
          "type": "array",
          "description": "Other agents or services this agent depends on",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "registered_at": {
      "type": "integer",
      "description": "Unix timestamp (ms) when agent was registered"
    },
    "last_seen_at": {
      "type": "integer",
      "description": "Unix timestamp (ms) of last heartbeat/activity"
    },
    "updated_at": {
      "type": "integer",
      "description": "Unix timestamp (ms) of last metadata update"
    },
    "retired_at": {
      "type": "integer",
      "description": "Unix timestamp (ms) when agent was retired (if applicable)"
    },
    "health": {
      "type": "object",
      "description": "Health check information",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["healthy", "degraded", "unhealthy", "unknown"],
          "default": "unknown"
        },
        "last_check_at": {
          "type": "integer",
          "description": "Unix timestamp (ms) of last health check"
        },
        "error_count": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "consecutive_failures": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "message": {
          "type": "string",
          "description": "Health status message or last error"
        }
      }
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "agent_id": "coordinator-master-abc12345",
      "agent_type": "master",
      "agent_class": "coordinator-master",
      "name": "Coordinator Master",
      "description": "Central orchestrator for task routing and master coordination",
      "version": "1.0.0",
      "status": "active",
      "capabilities": [
        {
          "capability_id": "task_routing",
          "name": "Task Routing",
          "category": "orchestration",
          "parameters": {
            "routing_algorithm": "moe",
            "confidence_threshold": 0.7
          }
        },
        {
          "capability_id": "master_coordination",
          "name": "Master Coordination",
          "category": "orchestration"
        }
      ],
      "configuration": {
        "max_concurrent_tasks": 10,
        "timeout_seconds": 600,
        "priority": "critical",
        "auto_restart": true
      },
      "performance": {
        "tasks_completed": 1247,
        "tasks_failed": 42,
        "success_rate": 0.967,
        "average_execution_time_ms": 2340,
        "total_tokens_used": 584920,
        "uptime_seconds": 86400
      },
      "metadata": {
        "owner": "system",
        "tags": ["core", "orchestration", "critical"],
        "source_location": "coordination/masters/coordinator"
      },
      "registered_at": 1700000000000,
      "last_seen_at": 1700086400000,
      "updated_at": 1700086400000,
      "health": {
        "status": "healthy",
        "last_check_at": 1700086400000,
        "error_count": 0,
        "consecutive_failures": 0
      }
    }
  ]
}
