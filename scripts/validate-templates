#!/usr/bin/env bash
#
# Template Validation CLI
# Part of Q2 Week 23-24: Agent Designer & Templates
#
# Command-line interface for validating agent templates
#

set -euo pipefail

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Source validator library
source "$SCRIPT_DIR/lib/agentstudio/template-validator.sh"

#
# Main CLI
#
main() {
    local command="${1:-all}"

    case "$command" in
        all)
            local verbose="${2:-false}"
            validate_all_templates "$verbose"
            ;;
        template)
            local template_file="${2:?Template file required}"
            local verbose="${3:-true}"
            validate_template "$template_file" "$verbose"
            ;;
        help|--help|-h)
            cat <<EOF
Template Validation CLI

Usage: $0 <command> [options]

Commands:
  all [verbose]            Validate all templates (default)
                          verbose: true|false (default: false)
  template <file> [verbose]
                          Validate specific template file
                          verbose: true|false (default: true)
  help                    Show this help message

Examples:
  # Validate all templates
  $0 all

  # Validate all templates with verbose output
  $0 all true

  # Validate specific template
  $0 template coordination/agentstudio/templates/basic-master-template.json

  # Validate specific template with minimal output
  $0 template coordination/agentstudio/templates/basic-master-template.json false

EOF
            ;;
        *)
            echo "Unknown command: $command"
            echo "Use '$0 help' for usage information"
            exit 1
            ;;
    esac
}

# Run CLI
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
