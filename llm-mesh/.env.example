# LLM Mesh Environment Configuration
# Copy this file to .env and fill in your actual API keys

# ============================================================================
# LLM Provider API Keys
# ============================================================================

# Anthropic Claude (recommended for primary use)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI GPT (optional, for multi-provider support)
OPENAI_API_KEY=your-openai-api-key-here

# ============================================================================
# Gateway Configuration
# ============================================================================

# Primary provider (anthropic|openai|local)
LLM_PRIMARY_PROVIDER=anthropic

# Fallback provider (optional)
LLM_FALLBACK_PROVIDER=openai

# Cost limit per task (USD)
LLM_MAX_COST_PER_TASK=0.50

# Quality requirement (economical|balanced|premium)
LLM_DEFAULT_QUALITY=balanced

# ============================================================================
# Safety & Quality Configuration
# ============================================================================

# Enable safety filters (true|false)
SAFETY_ENABLE_PII_FILTER=true
SAFETY_ENABLE_INJECTION_FILTER=true
SAFETY_ENABLE_SECRETS_FILTER=true

# Minimum quality score (0.0-1.0)
SAFETY_MIN_QUALITY_SCORE=0.7

# Action on safety violations (detect|block|redact)
SAFETY_DEFAULT_ACTION=block

# ============================================================================
# MoE Learning Configuration
# ============================================================================

# Enable learning from outcomes (true|false)
MOE_ENABLE_LEARNING=true

# Minimum confidence threshold for routing
MOE_MIN_CONFIDENCE=0.3

# Learning batch size (outcomes before re-learning)
MOE_LEARNING_BATCH_SIZE=10

# ============================================================================
# Performance & Monitoring
# ============================================================================

# Enable performance tracking (true|false)
PERF_ENABLE_TRACKING=true

# Log level (debug|info|warn|error)
LOG_LEVEL=info

# Metrics retention days
METRICS_RETENTION_DAYS=30

# ============================================================================
# Local Model Configuration (optional)
# ============================================================================

# Ollama endpoint (if using local models)
OLLAMA_ENDPOINT=http://localhost:11434

# Local model name
OLLAMA_MODEL=llama2

# ============================================================================
# LangSmith Observability & Monitoring
# ============================================================================

# Enable LangChain tracing to LangSmith (true|false)
LANGCHAIN_TRACING_V2=true

# Your LangSmith API key from https://smith.langchain.com/settings
LANGCHAIN_API_KEY=your-langsmith-api-key-here

# Project name in LangSmith (organizes traces by project)
LANGCHAIN_PROJECT=commit-relay

# Optional: Custom LangSmith endpoint
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
