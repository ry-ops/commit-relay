{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "manifestVersion": "1.0.0",
  "master": {
    "id": "security-master",
    "name": "Security Master",
    "description": "Specialist for vulnerability scanning, security audits, CVE remediation, and compliance monitoring",
    "version": "4.0.0",
    "role": "specialist"
  },
  "capabilities": [
    {
      "name": "vulnerability_scanning",
      "description": "Scan repositories for security vulnerabilities using multiple databases",
      "inputSchema": {
        "type": "object",
        "properties": {
          "repository": { "type": "string" },
          "scan_type": {
            "type": "string",
            "enum": ["full", "quick", "dependencies", "code"]
          },
          "severity_threshold": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          }
        },
        "required": ["repository"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "vulnerabilities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "severity": { "type": "string" },
                "package": { "type": "string" },
                "description": { "type": "string" },
                "fix_available": { "type": "boolean" }
              }
            }
          },
          "summary": {
            "type": "object",
            "properties": {
              "critical": { "type": "number" },
              "high": { "type": "number" },
              "medium": { "type": "number" },
              "low": { "type": "number" }
            }
          }
        }
      }
    },
    {
      "name": "dependency_auditing",
      "description": "Audit project dependencies for known vulnerabilities and outdated packages",
      "inputSchema": {
        "type": "object",
        "properties": {
          "repository": { "type": "string" },
          "package_manager": {
            "type": "string",
            "enum": ["npm", "pip", "cargo", "go", "maven", "gradle"]
          }
        },
        "required": ["repository"]
      }
    },
    {
      "name": "secrets_detection",
      "description": "Detect hardcoded secrets, API keys, and credentials in code",
      "inputSchema": {
        "type": "object",
        "properties": {
          "repository": { "type": "string" },
          "scan_history": { "type": "boolean", "default": false }
        },
        "required": ["repository"]
      }
    },
    {
      "name": "security_remediation",
      "description": "Automatically fix security vulnerabilities with patches or updates",
      "inputSchema": {
        "type": "object",
        "properties": {
          "vulnerability_id": { "type": "string" },
          "auto_fix": { "type": "boolean", "default": false },
          "create_pr": { "type": "boolean", "default": true }
        },
        "required": ["vulnerability_id"]
      }
    },
    {
      "name": "compliance_monitoring",
      "description": "Monitor compliance with security frameworks (SOC2, ISO27001, etc.)"
    }
  ],
  "workerTypes": ["scan-worker", "security-fix-worker"],
  "threatDatabases": ["CVE", "NVD", "npm_advisories", "pip_advisories", "OSV"],
  "dependencies": {
    "masters": ["coordinator-master"],
    "services": ["governance", "token-budget"],
    "tools": ["npm-audit", "pip-audit", "trivy", "gitleaks"]
  },
  "constraints": {
    "maxConcurrentScans": 10,
    "tokenBudget": 35000,
    "scanTimeout": 300000
  },
  "metrics": {
    "tracked": ["vulnerabilities_found", "vulnerabilities_fixed", "scan_duration", "false_positive_rate"],
    "successCriteria": {
      "min_detection_rate": 0.95,
      "max_false_positive_rate": 0.1
    }
  },
  "mcp": {
    "tools": ["spawn_worker", "check_governance"],
    "resources": ["commit-relay://coordination/worker-pool"]
  }
}
