# Test Environment Variables
# Copy this file to .env.test and fill in with test credentials

# Test API Configuration
TEST_BASE_URL=http://localhost:19999
TEST_API_KEY=test-api-key-here

# Test Repository Patterns (for workflow security tests)
TRUSTED_REPOSITORY_PATTERNS=https://github.com/test-org/*,https://github.com/trusted-user/*

# Test Database Configuration
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=test_db
TEST_DB_USER=test_user
TEST_DB_PASSWORD=****word

# Test Authentication
TEST_AUTH_TOKEN=test-token-here
TEST_CLIENT_ID=test-client-id
TEST_CLIENT_SECRET=test-client-secret
